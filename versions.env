PG_VERSION=18.1.0
PGVECTOR_VERSION=0.8.5
PGVECTOR_COMPILED_TAG=v0.18.320
PGVECTOR_COMPILED_REPO=nicoloboschi/pgvector_compiled

# Runtime libraries bundled with the Linux GNU binaries.
#
# The theseus-rs PostgreSQL build does NOT directly link against ICU. It
# links against libxml2.so.2 (DT_NEEDED), and libxml2 in turn pulls in ICU
# transitively. So we bundle a libxml2.so.2 + the matching libicu it was
# built against, all sourced from the same Ubuntu archive.
#
# We deliberately use Ubuntu 22.04 (Jammy) packages because:
#   1. Their glibc symbol requirements top out at GLIBC 2.34, comfortably
#      below our manylinux_2_35 wheel baseline. Using Ubuntu 24.04 packages
#      would require GLIBC 2.38, breaking users on Ubuntu 22.04 / Debian 12.
#   2. Ubuntu 22.04's libxml2.so.2 transitively wants libicu*.so.70, so we
#      bundle that ICU major rather than the .so.74 ICU 24.04 ships.
# This works on every supported distro: 22.04 has the same SONAMEs natively;
# 24.04+ keeps libxml2.so.2 around but in a newer ICU lineage; 25.10+ has
# neither, but the bundled libxml2.so.2 + libicu70 fills both gaps.
# build.rs falls back to Launchpad (which keeps every published .deb) when
# the archive pool has dropped a superseded build (how the ubuntu0.12 pin broke).
LIBXML2_DEB_VERSION=2.9.13+dfsg-1ubuntu0.14
LIBXML2_DEB_URL_AMD64=https://archive.ubuntu.com/ubuntu/pool/main/libx/libxml2/libxml2_2.9.13+dfsg-1ubuntu0.14_amd64.deb
LIBXML2_DEB_SHA256_AMD64=16e395b2c52d6ab232053468febc69f0876956ec2fae357a941a2a8dab36574f
LIBXML2_DEB_URL_ARM64=https://ports.ubuntu.com/ubuntu-ports/pool/main/libx/libxml2/libxml2_2.9.13+dfsg-1ubuntu0.14_arm64.deb
LIBXML2_DEB_SHA256_ARM64=1e85b731baabd51331d70a6392c652bc39fa2c231ff784555bd6a61631009387
LIBICU_DEB_VERSION=70.1-2ubuntu1
LIBICU_DEB_URL_AMD64=http://archive.ubuntu.com/ubuntu/pool/main/i/icu/libicu70_70.1-2ubuntu1_amd64.deb
LIBICU_DEB_SHA256_AMD64=223c1e6cebf2a6748637303227d8b84337c14a2d30eacbc46a68d02557dcff3e
LIBICU_DEB_URL_ARM64=http://ports.ubuntu.com/pool/main/i/icu/libicu70_70.1-2ubuntu1_arm64.deb
LIBICU_DEB_SHA256_ARM64=a06f86489e364f555a0655f476e6b2693760aff9d8dec0011daf9b17957da3c5

# OpenSSL bundled with the macOS binaries.
#
# The theseus-rs macOS PostgreSQL build loads libssl/libcrypto from
# /opt/homebrew/opt/openssl@3, so it cannot start on a Mac without Homebrew.
# build.rs copies these libraries into the bundle's lib/ and rewrites every
# reference to @loader_path. conda-forge is used because it publishes
# checksummed OpenSSL builds for both macOS architectures (deployment target
# macOS 11); 3.5 is OpenSSL's current LTS line.
OPENSSL_CONDA_VERSION=3.5.9
OPENSSL_CONDA_URL_ARM64=https://conda.anaconda.org/conda-forge/osx-arm64/openssl-3.5.9-h55eecbc_0.conda
OPENSSL_CONDA_SHA256_ARM64=a26829f8d4ed2631216a8543ef7704d2cff90ce43e381015530ab21cf762b681
OPENSSL_CONDA_URL_X86_64=https://conda.anaconda.org/conda-forge/osx-64/openssl-3.5.9-h332eb6d_0.conda
OPENSSL_CONDA_SHA256_X86_64=4747221abec91a82a8ebd7e8b36eac90c21c74435f9473c86c0e41a9305f2183
